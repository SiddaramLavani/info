
#!/bin/sh

INPUT_FILE="sysfs_list.txt"
OUTPUT_FILE="sysfs_values.txt"

# Create output file and add header
echo "Sysfs_Name,Value" > "$OUTPUT_FILE"

while IFS= read -r path || [ -n "$path" ]
do
    # Skip empty lines
    [ -z "$path" ] && continue

    # Extract sysfs name from path
    name=$(basename "$path")

    # Read sysfs value
    if [ -r "$path" ]; then
        value=$(cat "$path" 2>/dev/null)
    else
        value="NOT_ACCESSIBLE"
    fi

    # Write name and value
    printf '%s,%s\n' "$name" "$value" >> "$OUTPUT_FILE"

done < "$INPUT_FILE"

echo "Sysfs values saved to $OUTPUT_FILE"
