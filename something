};




static ssize_t file_io_stats_reset_write(struct file *file,
					 const char __user *buf,
					 size_t count, loff_t *ppos)
{
	LIST_HEAD(free_list);
	struct f2fs_stat_info *si;
	struct f2fs_file_io_stat *stat, *tmp;

	mutex_lock(&f2fs_stat_mutex);

	list_for_each_entry(si, &f2fs_stat_list, stat_list) {
		spin_lock(&si->file_io_lock);

		list_for_each_entry_safe(stat, tmp,
					 &si->file_io_list, list) {
			list_del(&stat->list);
			list_add(&stat->list, &free_list);
		}

		spin_unlock(&si->file_io_lock);
	}

	mutex_unlock(&f2fs_stat_mutex);

	list_for_each_entry_safe(stat, tmp, &free_list, list) {
		list_del(&stat->list);
		iput(stat->inode);
		kfree(stat);
	}

	return count;
}

static const struct file_operations file_io_stats_reset_fops = {
	.owner	= THIS_MODULE,
	.write	= file_io_stats_reset_write,
};




