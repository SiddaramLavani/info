  static int file_io_stats_show(struct seq_file *seq, void *v)
{
	struct f2fs_stat_info *si;
	struct f2fs_file_io_stat *stat;

	seq_puts(seq,
		"DEV\tINODE\tPID\tCOMM\tPIN\tMODE\t"
		"READ\tWRITE\tDREAD\tBREAD\tDWRITE\tBWRITE\tFILE\n");

	seq_puts(seq,
		"--------------------------------------------------------------------------------\n");

	mutex_lock(&f2fs_stat_mutex);

	list_for_each_entry(si, &f2fs_stat_list, stat_list) {
		spin_lock(&si->file_io_lock);

		list_for_each_entry(stat, &si->file_io_list, list) {
			const char *mode;

			if (stat->direct_read_bytes ||
			    stat->direct_write_bytes) {
				if (stat->buffered_read_bytes ||
				    stat->buffered_write_bytes)
					mode = "MIXED";
				else
					mode = "DIRECT";
			} else {
				mode = "BUFFERED";
			}

			seq_printf(seq,
				"%pg\t%lu\t%d\t%s\t%c\t%s\t"
				"%llu\t%llu\t%llu\t%llu\t%llu\t%llu\t%s\n",
				si->sbi->sb->s_bdev,
				stat->inode->i_ino,
				stat->pid,
				stat->comm,
				f2fs_is_pinned_file(stat->inode) ? 'Y' : 'N',
				mode,
				stat->read_bytes,
				stat->write_bytes,
				stat->direct_read_bytes,
				stat->buffered_read_bytes,
				stat->direct_write_bytes,
				stat->buffered_write_bytes,
				stat->filename);
		}

		spin_unlock(&si->file_io_lock);
	}

	mutex_unlock(&f2fs_stat_mutex);

	return 0;
}

static int file_io_stats_open(struct inode *inode, struct file *file)
{
	return single_open(file, file_io_stats_show, NULL);
}

