static struct f2fs_file_io_stat *
f2fs_file_io_stat_find(struct f2fs_stat_info *si, struct inode *inode)
{
	struct f2fs_file_io_stat *stat;

	list_for_each_entry(stat, &si->file_io_list, list) {
		if (stat->inode == inode)
			return stat;
	}

	return NULL;
}

static struct f2fs_file_io_stat *
f2fs_file_io_stat_get(struct file *file)
{
	struct inode *inode = file_inode(file);
	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
	struct f2fs_stat_info *si = F2FS_STAT(sbi);
	struct f2fs_file_io_stat *stat;
	unsigned long flags;

	spin_lock_irqsave(&si->file_io_lock, flags);

	stat = f2fs_file_io_stat_find(si, inode);
	if (stat) {
		spin_unlock_irqrestore(&si->file_io_lock, flags);
		return stat;
	}

	spin_unlock_irqrestore(&si->file_io_lock, flags);

	stat = kzalloc(sizeof(*stat), GFP_NOFS);
	if (!stat)
		return NULL;

	stat->inode = inode;
	stat->pid = current->tgid;
	strscpy(stat->comm, current->comm, sizeof(stat->comm));

	/*
	 * Keep the inode alive while the statistics entry exists.
	 */
	ihold(inode);

	if (file_dentry(file))
		strscpy(stat->filename,
			file_dentry(file)->d_name.name,
			sizeof(stat->filename));

	spin_lock_irqsave(&si->file_io_lock, flags);

	/*
	 * Check again because another CPU could have created the
	 * entry while we were allocating it.
	 */
	{
		struct f2fs_file_io_stat *old;

		old = f2fs_file_io_stat_find(si, inode);
		if (old) {
			spin_unlock_irqrestore(&si->file_io_lock, flags);
			iput(inode);
			kfree(stat);
			return old;
		}
	}

	list_add_tail(&stat->list, &si->file_io_list);

	spin_unlock_irqrestore(&si->file_io_lock, flags);

	return stat;
}

void f2fs_file_io_stat_read(struct file *file, ssize_t bytes,
			    bool direct)
{
	struct inode *inode = file_inode(file);
	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
	struct f2fs_stat_info *si = F2FS_STAT(sbi);
	struct f2fs_file_io_stat *stat;
	unsigned long flags;

	if (bytes <= 0 || !S_ISREG(inode->i_mode))
		return;

	stat = f2fs_file_io_stat_get(file);
	if (!stat)
		return;

	spin_lock_irqsave(&si->file_io_lock, flags);

	stat->read_bytes += bytes;
	stat->read_ops++;

	if (direct)
		stat->direct_read_bytes += bytes;
	else
		stat->buffered_read_bytes += bytes;

	spin_unlock_irqrestore(&si->file_io_lock, flags);
}

