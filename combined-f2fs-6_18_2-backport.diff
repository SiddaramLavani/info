+/*
+ * Per-bio state placed in front of every bio allocated from f2fs_bioset.
+ * @work is used to complete a write bio from the f2fs workqueue when
+ * f2fs_write_end_io() is called in atomic context. @entry_cnt is the number
+ * of entries (folios) added to a write bio.
+ */
+struct f2fs_bio {
+	struct work_struct work;
+	unsigned int entry_cnt;
+	struct bio bio;
+};
+
+static inline struct f2fs_bio *F2FS_BIO(struct bio *bio)
+{
+	return container_of(bio, struct f2fs_bio, bio);
+}
